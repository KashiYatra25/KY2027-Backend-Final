// ═══════════════════════════════════════════════════════════════════
// GRAFANA ALLOY CONFIGURATION
// 
// Collects logs and metrics from ky-2027-backend and forwards to
// Grafana Cloud.
//
// Environment variables required (set in .env or docker-compose):
//   GRAFANA_CLOUD_LOKI_URL       - Loki push endpoint
//   GRAFANA_CLOUD_LOKI_USER      - Loki user ID
//   GRAFANA_CLOUD_PROMETHEUS_URL - Prometheus remote write endpoint  
//   GRAFANA_CLOUD_PROMETHEUS_USER- Prometheus user ID
//   GRAFANA_CLOUD_API_KEY        - API key (works for both)
//   NODE_ENV                     - development/production
//
// Run with: alloy run alloy.config
// ═══════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────
// LOGGING - Collect from app and forward to Loki
// ───────────────────────────────────────────────────────────────────

// Receive logs via HTTP (app pushes JSON logs here)
loki.source.api "http_receiver" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3100
  }
  forward_to = [loki.process.add_labels.receiver]
}

// Add common labels to all logs
loki.process "add_labels" {
  stage.static_labels {
    values = {
      app = "ky-2027-backend",
      env = coalesce(env("NODE_ENV"), "development"),
    }
  }
  forward_to = [loki.write.grafana_cloud.receiver]
}

// Write logs to Grafana Cloud Loki
loki.write "grafana_cloud" {
  endpoint {
    url = coalesce(env("GRAFANA_CLOUD_LOKI_URL"), "https://logs-prod-028.grafana.net/loki/api/v1/push")
    
    basic_auth {
      username = coalesce(env("GRAFANA_CLOUD_LOKI_USER"), "1814024")
      password = env("GRAFANA_CLOUD_API_KEY")
    }
  }
  
  external_labels = {
    instance = coalesce(env("HOSTNAME"), "localhost"),
  }
}

// ───────────────────────────────────────────────────────────────────
// METRICS - Scrape from app and forward to Prometheus
// ───────────────────────────────────────────────────────────────────

// Scrape Prometheus metrics from the Node.js app
prometheus.scrape "app_metrics" {
  targets = [{
    __address__ = coalesce(env("APP_HOST"), "host.docker.internal:8000"),
  }]
  
  metrics_path = "/metrics"
  scrape_interval = "15s"
  
  forward_to = [prometheus.relabel.add_labels.receiver]
}

// Add common labels to all metrics
prometheus.relabel "add_labels" {
  rule {
    target_label = "app"
    replacement  = "ky-2027-backend"
  }
  rule {
    target_label = "env"
    replacement  = coalesce(env("NODE_ENV"), "development")
  }
  
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// Write metrics to Grafana Cloud Prometheus
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = coalesce(env("GRAFANA_CLOUD_PROMETHEUS_URL"), "https://prometheus-prod-43-prod-ap-south-1.grafana.net/api/prom/push")
    
    basic_auth {
      username = coalesce(env("GRAFANA_CLOUD_PROMETHEUS_USER"), "3636715")
      password = env("GRAFANA_CLOUD_API_KEY")
    }
    
    // Queue config for handling spikes
    queue_config {
      capacity             = 10000
      max_shards           = 5
      max_samples_per_send = 2000
    }
  }
}

// ───────────────────────────────────────────────────────────────────
// HOST METRICS (optional) - CPU, memory, disk
// ───────────────────────────────────────────────────────────────────

// Uncomment to collect host metrics
// prometheus.exporter.unix "host" {
//   // Default collectors: cpu, disk, filesystem, loadavg, memory, netstat
// }
// 
// prometheus.scrape "host_metrics" {
//   targets    = prometheus.exporter.unix.host.targets
//   forward_to = [prometheus.relabel.add_labels.receiver]
//   scrape_interval = "30s"
// }
