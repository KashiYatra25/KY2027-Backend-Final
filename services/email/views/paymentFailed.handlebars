<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Payment Failed - Kashiyatra 2027</title>
</head>
<body style="margin: 0; padding: 0; background-color: #0a0a15; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #0a0a15;">
        <tr>
            <td style="padding: 20px 0;">
                <!-- Main Container -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; margin: 0 auto; background-color: #1A1A2E; border-radius: 12px; overflow: hidden; border: 1px solid #ef444433;">
                    <!-- Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 100%); padding: 40px 20px; text-align: center;">
                            <h1 style="margin: 0; color: #FDF6E3; font-size: 28px; font-weight: 800; letter-spacing: 2px;">KASHIYATRA 2027</h1>
                            <p style="margin: 8px 0 0 0; color: #FDF6E3; font-size: 14px; font-weight: 600; opacity: 0.9;">Payment {{status}}</p>
                        </td>
                    </tr>
                    
                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 30px;">
                            <!-- Warning Icon -->
                            <div style="text-align: center; margin-bottom: 24px;">
                                <div style="display: inline-block; width: 64px; height: 64px; background-color: #7f1d1d; border-radius: 50%; line-height: 64px; font-size: 32px;">
                                    ⚠️
                                </div>
                            </div>

                            <h2 style="margin: 0 0 20px 0; color: #FDF6E3; font-size: 22px; font-weight: 600; line-height: 1.3; text-align: center;">
                                {{#if isExpired}}
                                    Payment Session Expired
                                {{else}}
                                    Payment Unsuccessful
                                {{/if}}
                            </h2>
                            
                            <p style="margin: 0 0 16px 0; color: #D4B896; font-size: 16px; line-height: 1.6; text-align: center;">
                                Hi {{userName}}, we noticed that your payment for Kashiyatra 2027 passes 
                                {{#if isExpired}}
                                    session has expired.
                                {{else}}
                                    could not be completed.
                                {{/if}}
                            </p>

                            <!-- Order Details Box -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 24px 0;">
                                <tr>
                                    <td style="padding: 24px; background-color: #0a0a15; border-radius: 8px; border: 1px solid #ef444430;">
                                        <!-- Order Info -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid #ef444420;">
                                            <tr>
                                                <td>
                                                    <p style="margin: 0; color: #ef4444; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">Order ID</p>
                                                    <p style="margin: 4px 0 0 0; color: #FDF6E3; font-size: 14px; font-family: monospace;">#{{orderId}}</p>
                                                </td>
                                                <td style="text-align: right;">
                                                    <p style="margin: 0; color: #8B8B8B; font-size: 12px;">Amount</p>
                                                    <p style="margin: 4px 0 0 0; color: #FDF6E3; font-size: 18px; font-weight: 700;">₹{{totalAmount}}</p>
                                                </td>
                                            </tr>
                                        </table>

                                        <!-- Items Summary -->
                                        <p style="margin: 0 0 12px 0; color: #8B8B8B; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">Items in your order</p>
                                        
                                        {{#each items}}
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td style="padding: 8px 0; color: #FDF6E3; font-size: 14px;">{{this.passName}}</td>
                                                <td style="padding: 8px 0; color: #D4B896; font-size: 14px; text-align: right;">× {{this.quantity}}</td>
                                            </tr>
                                        </table>
                                        {{/each}}

                                        <!-- Status -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 16px; padding-top: 16px; border-top: 1px solid #ef444420;">
                                            <tr>
                                                <td>
                                                    <span style="display: inline-block; padding: 6px 12px; background-color: #7f1d1d; color: #fca5a5; font-size: 12px; font-weight: 600; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.5px;">
                                                        {{status}}
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- What to do next -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
                                <tr>
                                    <td style="padding: 20px; background-color: #1a1a2e; border-radius: 8px; border: 1px solid #D4A85320;">
                                        <p style="margin: 0 0 12px 0; color: #D4A853; font-size: 14px; font-weight: 700;">What can you do?</p>
                                        <ul style="margin: 0; padding-left: 20px; color: #D4B896; font-size: 14px; line-height: 1.8;">
                                            <li>Your items are still in your cart</li>
                                            <li>Try completing the payment again</li>
                                            <li>Use a different payment method if needed</li>
                                            <li>Contact support if the issue persists</li>
                                        </ul>
                                    </td>
                                </tr>
                            </table>

                            <!-- CTA Button -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center; padding: 10px 0;">
                                        <a href="{{cartUrl}}" style="display: inline-block; padding: 16px 40px; background: linear-gradient(135deg, #D4A853 0%, #B8860B 100%); color: #0a0a15; font-size: 14px; font-weight: 700; text-decoration: none; border-radius: 8px; text-transform: uppercase; letter-spacing: 1px;">
                                            Try Again
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin: 24px 0 0 0; color: #6B6B6B; font-size: 13px; line-height: 1.6; text-align: center;">
                                If your money was deducted, it will be refunded within 5-7 business days. For any queries, please contact us at 
                                <a href="mailto:support@kashiyatra.in" style="color: #D4A853; text-decoration: none;">support@kashiyatra.in</a>
                            </p>
                        </td>
                    </tr>
                    
                    <!-- Footer -->
                    <tr>
                        <td style="padding: 30px; background-color: #0a0a15; border-top: 1px solid #D4A85320;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center;">
                                        <p style="margin: 0 0 8px 0; color: #D4A853; font-size: 16px; font-weight: 700; letter-spacing: 1px;">KASHIYATRA 2027</p>
                                        <p style="margin: 0 0 16px 0; color: #6B6B6B; font-size: 12px;">IIT BHU's Premier Cultural Festival</p>
                                        <p style="margin: 0; color: #4B4B4B; font-size: 11px;">
                                            © 2027 Kashiyatra, IIT (BHU) Varanasi. All rights reserved.
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
