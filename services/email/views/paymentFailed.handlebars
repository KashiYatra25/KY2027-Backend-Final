<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Payment Failed - Kashiyatra 2027</title>
</head>
<body style="margin: 0; padding: 0; background-color: #0d1117; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #0d1117;">
        <tr>
            <td style="padding: 20px 10px;">
                <!-- Main Container -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; margin: 0 auto; background-color: #161b22; border-radius: 16px; overflow: hidden; border: 1px solid #30363d;">
                    
                    <!-- Header with deep rose/maroon -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #450a0a 0%, #7f1d1d 50%, #991b1b 100%); padding: 45px 20px; text-align: center;">
                            <h1 style="margin: 0; color: #fecaca; font-size: 28px; font-weight: 800; letter-spacing: 3px; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">KASHIYATRA 2027</h1>
                            <p style="margin: 12px 0 0 0; color: #fca5a5; font-size: 15px; font-weight: 600; letter-spacing: 2px;">PAYMENT {{status}}</p>
                        </td>
                    </tr>
                    
                    <!-- Alert Banner -->
                    <tr>
                        <td style="background: linear-gradient(90deg, #1c1917 0%, #292524 50%, #1c1917 100%); padding: 28px 20px; text-align: center; border-bottom: 3px solid #ef4444;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center;">
                                        <!-- Warning circle -->
                                        <div style="display: inline-block; width: 70px; height: 70px; background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%); border-radius: 50%; line-height: 70px; margin-bottom: 16px; box-shadow: 0 0 30px rgba(220, 38, 38, 0.4);">
                                            <span style="color: #ffffff; font-size: 36px;">✕</span>
                                        </div>
                                        <h2 style="margin: 0; color: #fca5a5; font-size: 24px; font-weight: 700;">
                                            {{#if isExpired}}
                                            Payment Session Expired
                                            {{else}}
                                            Payment Unsuccessful
                                            {{/if}}
                                        </h2>
                                        <p style="margin: 12px 0 0 0; color: #d6d3d1; font-size: 15px; line-height: 1.6;">
                                            Hi <strong style="color: #fbbf24;">{{userName}}</strong>, your payment for Kashiyatra 2027 passes
                                            {{#if isExpired}}
                                            session has expired.
                                            {{else}}
                                            could not be completed.
                                            {{/if}}
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    
                    <!-- Content -->
                    <tr>
                        <td style="padding: 35px 25px;">

                            <!-- Order Details Box -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0; border: 1px solid #30363d; border-radius: 12px; overflow: hidden;">
                                <!-- Order Header -->
                                <tr>
                                    <td style="background: linear-gradient(90deg, #1c1c1c 0%, #262626 50%, #1c1c1c 100%); padding: 18px 20px; border-bottom: 1px solid #30363d;">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td>
                                                    <p style="margin: 0; color: #ef4444; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;">ORDER ID</p>
                                                    <p style="margin: 6px 0 0 0; color: #e5e7eb; font-size: 13px; font-family: 'SF Mono', Monaco, monospace; word-break: break-all;">#{{orderId}}</p>
                                                </td>
                                                <td style="text-align: right;">
                                                    <p style="margin: 0; color: #9ca3af; font-size: 11px; text-transform: uppercase;">Amount</p>
                                                    <p style="margin: 6px 0 0 0; color: #f3f4f6; font-size: 22px; font-weight: 700;">₹{{totalAmount}}</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                
                                <!-- Items -->
                                <tr>
                                    <td style="padding: 20px; background-color: #0d1117;">
                                        <p style="margin: 0 0 14px 0; color: #9ca3af; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;">Items in your order</p>
                                        
                                        {{#each items}}
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td style="padding: 12px 0; color: #e5e7eb; font-size: 15px; font-weight: 500; border-bottom: 1px solid #21262d;">{{this.passName}}</td>
                                                <td style="padding: 12px 0; color: #9ca3af; font-size: 15px; text-align: right; border-bottom: 1px solid #21262d;">× {{this.quantity}}</td>
                                            </tr>
                                        </table>
                                        {{/each}}

                                        <!-- Status Badge -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 18px;">
                                            <tr>
                                                <td>
                                                    <span style="display: inline-block; padding: 10px 20px; background: linear-gradient(135deg, #450a0a 0%, #7f1d1d 100%); color: #fca5a5; font-size: 13px; font-weight: 700; border-radius: 25px; text-transform: uppercase; letter-spacing: 1px; border: 1px solid #dc2626;">
                                                        {{status}}
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- What to do next - with warm amber accent -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 28px;">
                                <tr>
                                    <td style="padding: 22px; background: linear-gradient(90deg, #1c1917 0%, #292524 50%, #1c1917 100%); border-radius: 12px; border-left: 4px solid #fbbf24;">
                                        <p style="margin: 0 0 14px 0; color: #fbbf24; font-size: 16px; font-weight: 700;">💡 What can you do?</p>
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                                            <tr><td style="color: #d6d3d1; font-size: 14px; line-height: 2.2; padding-left: 4px;"><span style="color: #22c55e;">✓</span> Your items are still in your cart</td></tr>
                                            <tr><td style="color: #d6d3d1; font-size: 14px; line-height: 2.2; padding-left: 4px;"><span style="color: #22c55e;">✓</span> Try completing the payment again</td></tr>
                                            <tr><td style="color: #d6d3d1; font-size: 14px; line-height: 2.2; padding-left: 4px;"><span style="color: #22c55e;">✓</span> Use a different payment method</td></tr>
                                            <tr><td style="color: #d6d3d1; font-size: 14px; line-height: 2.2; padding-left: 4px;"><span style="color: #22c55e;">✓</span> Contact support if issues persist</td></tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- CTA Button -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center; padding: 10px 0 24px 0;">
                                        <a href="{{cartUrl}}" style="display: inline-block; padding: 18px 50px; background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); color: #0d1117; text-decoration: none; border-radius: 10px; font-weight: 800; font-size: 15px; letter-spacing: 1px; text-transform: uppercase; box-shadow: 0 4px 20px rgba(251, 191, 36, 0.4);">
                                            Try Again →
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <!-- Refund Notice -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 20px;">
                                <tr>
                                    <td style="padding: 18px 20px; background: linear-gradient(90deg, #052e16 0%, #14532d 50%, #052e16 100%); border-radius: 10px; border: 1px solid #22c55e;">
                                        <p style="margin: 0; color: #86efac; font-size: 14px; line-height: 1.6;">
                                            <strong style="color: #4ade80;">💰 Refund Notice:</strong> If your money was deducted, it will be automatically refunded within 5-7 business days.
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin: 0; color: #6b7280; font-size: 13px; line-height: 1.6; text-align: center;">
                                Need help? Contact us at 
                                <a href="mailto:support@kashiyatra.in" style="color: #fbbf24; text-decoration: none; font-weight: 600;">support@kashiyatra.in</a>
                            </p>
                        </td>
                    </tr>
                    
                    <!-- Footer -->
                    <tr>
                        <td style="padding: 28px 20px; background: linear-gradient(180deg, #0d1117 0%, #161b22 100%); text-align: center; border-top: 1px solid #30363d;">
                            <p style="margin: 0 0 6px 0; color: #fbbf24; font-size: 18px; font-weight: 700; letter-spacing: 3px;">KASHIYATRA 2027</p>
                            <p style="margin: 0 0 16px 0; color: #6b7280; font-size: 13px;">IIT BHU's Premier Cultural Festival</p>
                            <p style="margin: 0; color: #4b5563; font-size: 11px;">
                                © 2027 Kashiyatra, IIT (BHU) Varanasi
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
