<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Welcome to DataAvengers</title>
    <!--[if mso]>
    <style type="text/css">
        body, table, td {font-family: Arial, Helvetica, sans-serif !important;}
    </style>
    <![endif]-->
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f4f4f4;">
        <tr>
            <td style="padding: 20px 0;">
                <!-- Main Container -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                    <!-- Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #DA314E 0%, #F95F42 100%); padding: 40px 20px; text-align: center;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 32px; font-weight: 700; letter-spacing: -0.5px;">DataAvengers</h1>
                            <p style="margin: 8px 0 0 0; color: #ffffff; font-size: 14px; font-weight: 400; opacity: 0.9;">Empowering Your Learning Journey</p>
                        </td>
                    </tr>
                    
                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px 30px;">
                            <h2 style="margin: 0 0 20px 0; color: #1a1a1a; font-size: 24px; font-weight: 600; line-height: 1.3;">Assemble, {{name}}! 🦸♂️</h2>
                            
                            <p style="margin: 0 0 16px 0; color: #333333; font-size: 16px; line-height: 1.6;">We're stoked to have you join the <strong style="background: linear-gradient(to right, #DA314E, #F95F42); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">DataAvengers</strong> community.</p>
                            
                            <p style="margin: 0 0 24px 0; color: #333333; font-size: 16px; line-height: 1.6;">You've just unlocked access to world-class data science, AI, and analytics courses. Whether you're here to master Python or crush Big Data, we've got your back.</p>
                            
                            <!-- CTA Button -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center; padding: 10px 0 30px 0;">
                                        <a href="https://dataavengers.com/dashboard" style="display: inline-block; padding: 16px 40px; background: linear-gradient(to right, #DA314E, #F95F42); color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 16px; box-shadow: 0 4px 12px rgba(218, 49, 78, 0.3);">Start Learning Now</a>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- Features -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 24px 0;">
                                <tr>
                                    <td style="padding: 20px; background-color: #fff5f7; border-radius: 8px; border-left: 4px solid #DA314E;">
                                        <p style="margin: 0 0 12px 0; color: #1a1a1a; font-size: 15px; font-weight: 600;">✨ What's Next?</p>
                                        <ul style="margin: 0; padding-left: 20px; color: #555555; font-size: 14px; line-height: 1.8;">
                                            <li>Explore our course catalog</li>
                                            <li>Set up your learning profile</li>
                                            <li>Join our community forums</li>
                                        </ul>
                                    </td>
                                </tr>
                            </table>
                            
                            <p style="margin: 0 0 8px 0; color: #333333; font-size: 15px; line-height: 1.6;">Need a hand? Just reply to this email. Let's build something epic.</p>
                            
                            <p style="margin: 0; color: #333333; font-size: 15px; line-height: 1.6;">
                                Stay hungry,<br>
                                <strong style="color: #DA314E;">The DataAvengers Team</strong>
                            </p>
                        </td>
                    </tr>
                    
                    <!-- Footer -->
                    <tr>
                        <td style="padding: 30px 20px; background-color: #f8f9fa; text-align: center; border-top: 1px solid #e0e0e0;">
                            <p style="margin: 0 0 8px 0; color: #666666; font-size: 13px; line-height: 1.5;">&copy; 2026 DataAvengers Ed-Tech. All rights reserved.</p>
                            <p style="margin: 0; color: #999999; font-size: 12px; line-height: 1.5;">
                                <a href="https://dataavengers.com/privacy" style="color: #DA314E; text-decoration: none;">Privacy Policy</a> | 
                                <a href="https://dataavengers.com/terms" style="color: #DA314E; text-decoration: none;">Terms of Service</a>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
