<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Reset Password - Kashiyatra 2027</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f5f5f5;">
        <tr>
            <td style="padding: 40px 20px;">
                <!-- Main Container -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08);">
                    <!-- Header -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #8B1538 0%, #c4385a 50%, #D4A853 100%); padding: 48px 40px; text-align: center;">
                            <h1 style="margin: 0; color: #ffffff; font-size: 26px; font-weight: 700; letter-spacing: 3px; text-shadow: 0 2px 4px rgba(0,0,0,0.2);">KASHIYATRA 2027</h1>
                            <p style="margin: 12px 0 0 0; color: rgba(255,255,255,0.9); font-size: 13px; font-weight: 500; letter-spacing: 1px;">PASSWORD RESET REQUEST</p>
                        </td>
                    </tr>
                    
                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px;">
                            <!-- Icon -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
                                <tr>
                                    <td style="text-align: center;">
                                        <div style="display: inline-block; width: 64px; height: 64px; background: linear-gradient(135deg, #8B1538 0%, #a91d47 100%); border-radius: 16px; line-height: 64px; box-shadow: 0 4px 12px rgba(139,21,56,0.3);">
                                            <span style="font-size: 28px;">🔐</span>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Welcome -->
                            <h2 style="margin: 0 0 8px 0; color: #1a1a1a; font-size: 24px; font-weight: 600; text-align: center;">Password Reset</h2>
                            <p style="margin: 0 0 28px 0; color: #666666; font-size: 15px; line-height: 1.6; text-align: center;">
                                Hi <strong style="color: #8B1538;">{{userName}}</strong>, we received a request to reset your admin password.
                            </p>
                            
                            <!-- Info Card -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    <td style="padding: 20px 24px; background: linear-gradient(135deg, #fafafa 0%, #f0f0f0 100%); border-radius: 12px; border: 1px solid #e5e5e5;">
                                        <p style="margin: 0; color: #555555; font-size: 14px; line-height: 1.6;">
                                            Click the button below to create a new password. This link will expire in <strong style="color: #8B1538;">10 minutes</strong> for security reasons.
                                        </p>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- CTA Button -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center; padding: 8px 0 32px 0;">
                                        <a href="{{resetUrl}}" style="display: inline-block; padding: 16px 48px; background: linear-gradient(135deg, #8B1538 0%, #a91d47 100%); color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 14px; letter-spacing: 0.5px; box-shadow: 0 4px 12px rgba(139,21,56,0.3);">Reset Password →</a>
                                    </td>
                                </tr>
                            </table>

                            <!-- URL Fallback -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    <td style="padding: 16px; background-color: #f8f8f8; border-radius: 8px; border: 1px dashed #ddd;">
                                        <p style="margin: 0 0 8px 0; color: #888888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Or copy this link:</p>
                                        <p style="margin: 0; color: #8B1538; font-size: 12px; word-break: break-all; line-height: 1.5; font-family: 'SF Mono', Monaco, Consolas, 'Courier New', monospace;">{{resetUrl}}</p>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- Divider -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 24px 0;">
                                <tr>
                                    <td style="border-top: 1px solid #eeeeee;"></td>
                                </tr>
                            </table>
                            
                            <!-- Security Notice -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="padding: 16px 20px; background-color: #fef3c7; border-radius: 8px; border-left: 3px solid #f59e0b;">
                                        <p style="margin: 0 0 8px 0; color: #92400e; font-size: 13px; font-weight: 600;">⚠️ Didn't request this?</p>
                                        <p style="margin: 0; color: #a16207; font-size: 13px; line-height: 1.5;">
                                            If you didn't request a password reset, please ignore this email. Your password will remain unchanged and secure.
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    
                    <!-- Footer -->
                    <tr>
                        <td style="padding: 24px 40px; background-color: #fafafa; text-align: center; border-top: 1px solid #eeeeee;">
                            <p style="margin: 0 0 4px 0; color: #8B1538; font-size: 12px; font-weight: 600;">Kashiyatra 2027</p>
                            <p style="margin: 0; color: #999999; font-size: 11px;">IIT (BHU) Varanasi</p>
                        </td>
                    </tr>
                </table>
                
                <!-- Sub-footer -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 560px; margin: 20px auto 0;">
                    <tr>
                        <td style="text-align: center;">
                            <p style="margin: 0; color: #999999; font-size: 11px; line-height: 1.5;">
                                This link expires in 10 minutes.<br>
                                This is an automated message, please do not reply.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
