<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Account Status Update - Kashiyatra 2027</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f5f5f5;">
        <tr>
            <td style="padding: 40px 20px;">
                <!-- Main Container -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08);">
                    <!-- Header -->
                    <tr>
                        {{#if isSuspended}}
                        <td style="background: linear-gradient(135deg, #dc2626 0%, #b91c1c 50%, #991b1b 100%); padding: 48px 40px; text-align: center;">
                        {{else}}
                        <td style="background: linear-gradient(135deg, #059669 0%, #047857 50%, #065f46 100%); padding: 48px 40px; text-align: center;">
                        {{/if}}
                            <h1 style="margin: 0; color: #ffffff; font-size: 26px; font-weight: 700; letter-spacing: 3px; text-shadow: 0 2px 4px rgba(0,0,0,0.2);">KASHIYATRA 2027</h1>
                            <p style="margin: 12px 0 0 0; color: rgba(255,255,255,0.9); font-size: 13px; font-weight: 500; letter-spacing: 1px;">
                                {{#if isSuspended}}ACCOUNT SUSPENDED{{else}}ACCOUNT REACTIVATED{{/if}}
                            </p>
                        </td>
                    </tr>
                    
                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px;">
                            <!-- Icon -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
                                <tr>
                                    <td style="text-align: center;">
                                        {{#if isSuspended}}
                                        <div style="display: inline-block; width: 64px; height: 64px; background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%); border-radius: 16px; line-height: 64px; box-shadow: 0 4px 12px rgba(220,38,38,0.3);">
                                            <span style="font-size: 28px;">🚫</span>
                                        </div>
                                        {{else}}
                                        <div style="display: inline-block; width: 64px; height: 64px; background: linear-gradient(135deg, #059669 0%, #047857 100%); border-radius: 16px; line-height: 64px; box-shadow: 0 4px 12px rgba(5,150,105,0.3);">
                                            <span style="font-size: 28px;">✅</span>
                                        </div>
                                        {{/if}}
                                    </td>
                                </tr>
                            </table>

                            <!-- Title -->
                            {{#if isSuspended}}
                            <h2 style="margin: 0 0 8px 0; color: #dc2626; font-size: 24px; font-weight: 600; text-align: center;">Account Suspended</h2>
                            <p style="margin: 0 0 28px 0; color: #666666; font-size: 15px; line-height: 1.6; text-align: center;">
                                Hi <strong>{{userName}}</strong>, your admin account has been suspended.
                            </p>
                            {{else}}
                            <h2 style="margin: 0 0 8px 0; color: #059669; font-size: 24px; font-weight: 600; text-align: center;">Account Reactivated</h2>
                            <p style="margin: 0 0 28px 0; color: #666666; font-size: 15px; line-height: 1.6; text-align: center;">
                                Hi <strong>{{userName}}</strong>, great news! Your admin account has been reactivated.
                            </p>
                            {{/if}}
                            
                            <!-- Details Card -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    {{#if isSuspended}}
                                    <td style="padding: 24px; background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border-radius: 12px; border: 1px solid #fecaca;">
                                    {{else}}
                                    <td style="padding: 24px; background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border-radius: 12px; border: 1px solid #a7f3d0;">
                                    {{/if}}
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <!-- Action By -->
                                            <tr>
                                                <td style="padding: 8px 0; border-bottom: 1px solid {{#if isSuspended}}#fecaca{{else}}#a7f3d0{{/if}};">
                                                    <span style="display: block; color: #888888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Action By</span>
                                                    <span style="display: block; color: #1a1a1a; font-size: 14px; font-weight: 500;">{{suspendedByName}} ({{suspendedByRole}})</span>
                                                </td>
                                            </tr>
                                            {{#if isSuspended}}
                                            <!-- Reason -->
                                            <tr>
                                                <td style="padding: 12px 0 8px 0;">
                                                    <span style="display: block; color: #888888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Reason</span>
                                                    <span style="display: block; color: #1a1a1a; font-size: 14px; line-height: 1.5;">{{reason}}</span>
                                                </td>
                                            </tr>
                                            {{/if}}
                                        </table>
                                    </td>
                                </tr>
                            </table>
                            
                            {{#if isSuspended}}
                            <!-- What This Means -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    <td style="padding: 20px 24px; background-color: #f8f8f8; border-radius: 12px; border: 1px solid #e5e5e5;">
                                        <p style="margin: 0 0 12px 0; color: #1a1a1a; font-size: 14px; font-weight: 600;">What this means:</p>
                                        <ul style="margin: 0; padding-left: 20px; color: #666666; font-size: 13px; line-height: 1.8;">
                                            <li>You cannot access the admin panel</li>
                                            <li>All your admin sessions have been terminated</li>
                                            <li>Your permissions are temporarily revoked</li>
                                        </ul>
                                    </td>
                                </tr>
                            </table>
                            {{else}}
                            <!-- What You Can Do Now -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    <td style="padding: 20px 24px; background-color: #f8f8f8; border-radius: 12px; border: 1px solid #e5e5e5;">
                                        <p style="margin: 0 0 12px 0; color: #1a1a1a; font-size: 14px; font-weight: 600;">What you can do now:</p>
                                        <ul style="margin: 0; padding-left: 20px; color: #666666; font-size: 13px; line-height: 1.8;">
                                            <li>Log in to the admin panel as usual</li>
                                            <li>All your previous permissions have been restored</li>
                                            <li>Continue managing Kashiyatra 2027</li>
                                        </ul>
                                    </td>
                                </tr>
                            </table>
                            {{/if}}
                            
                            <!-- Divider -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 24px 0;">
                                <tr>
                                    <td style="border-top: 1px solid #eeeeee;"></td>
                                </tr>
                            </table>
                            
                            <!-- Contact Notice -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    {{#if isSuspended}}
                                    <td style="padding: 16px 20px; background-color: #fffbeb; border-radius: 8px; border-left: 3px solid #f59e0b;">
                                        <p style="margin: 0 0 8px 0; color: #92400e; font-size: 13px; font-weight: 600;">📧 Need help?</p>
                                        <p style="margin: 0; color: #a16207; font-size: 13px; line-height: 1.5;">
                                            If you believe this is a mistake, please contact your supervisor or the Master Admin for assistance.
                                        </p>
                                    </td>
                                    {{else}}
                                    <td style="padding: 16px 20px; background-color: #ecfdf5; border-radius: 8px; border-left: 3px solid #059669;">
                                        <p style="margin: 0 0 8px 0; color: #065f46; font-size: 13px; font-weight: 600;">🎉 Welcome back!</p>
                                        <p style="margin: 0; color: #047857; font-size: 13px; line-height: 1.5;">
                                            We're glad to have you back. If you have any questions, feel free to reach out.
                                        </p>
                                    </td>
                                    {{/if}}
                                </tr>
                            </table>
                        </td>
                    </tr>
                    
                    <!-- Footer -->
                    <tr>
                        <td style="padding: 24px 40px; background-color: #fafafa; text-align: center; border-top: 1px solid #eeeeee;">
                            <p style="margin: 0 0 4px 0; color: #8B1538; font-size: 12px; font-weight: 600;">Kashiyatra 2027</p>
                            <p style="margin: 0; color: #999999; font-size: 11px;">IIT (BHU) Varanasi</p>
                        </td>
                    </tr>
                </table>
                
                <!-- Sub-footer -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 560px; margin: 20px auto 0;">
                    <tr>
                        <td style="text-align: center;">
                            <p style="margin: 0; color: #999999; font-size: 11px; line-height: 1.5;">
                                This is an automated notification regarding your account status.<br>
                                Please do not reply to this email.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
