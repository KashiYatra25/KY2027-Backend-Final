<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>🎉 Payment Successful - Kashiyatra 2027</title>
</head>
<body style="margin: 0; padding: 0; background-color: #0d1117; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #0d1117;">
        <tr>
            <td style="padding: 20px 10px;">
                <!-- Main Container -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; margin: 0 auto; background-color: #161b22; border-radius: 16px; overflow: hidden; border: 1px solid #30363d;">
                    
                    <!-- Celebratory Header with Emerald & Gold -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #064e3b 0%, #065f46 50%, #047857 100%); padding: 45px 20px; text-align: center; position: relative;">
                            <!-- Sparkle decoration -->
                            <p style="margin: 0 0 8px 0; font-size: 32px;">✨🎊✨</p>
                            <h1 style="margin: 0; color: #ecfdf5; font-size: 28px; font-weight: 800; letter-spacing: 3px; text-shadow: 0 2px 10px rgba(0,0,0,0.3);">KASHIYATRA 2027</h1>
                            <p style="margin: 12px 0 0 0; color: #a7f3d0; font-size: 15px; font-weight: 600; letter-spacing: 2px;">PAYMENT SUCCESSFUL</p>
                        </td>
                    </tr>
                    
                    <!-- Success Confirmation Banner -->
                    <tr>
                        <td style="background: linear-gradient(90deg, #052e16 0%, #14532d 50%, #052e16 100%); padding: 24px 20px; text-align: center; border-bottom: 3px solid #22c55e;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center;">
                                        <!-- Success checkmark circle -->
                                        <div style="display: inline-block; width: 70px; height: 70px; background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); border-radius: 50%; line-height: 70px; margin-bottom: 16px; box-shadow: 0 0 30px rgba(34, 197, 94, 0.5);">
                                            <span style="color: #ffffff; font-size: 36px;">✓</span>
                                        </div>
                                        <h2 style="margin: 0; color: #4ade80; font-size: 26px; font-weight: 700; text-shadow: 0 0 20px rgba(74, 222, 128, 0.3);">
                                            Thank you, {{userName}}! 🎉
                                        </h2>
                                        <p style="margin: 10px 0 0 0; color: #86efac; font-size: 15px;">
                                            Your passes are confirmed. See you at the festival!
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    
                    <!-- Content -->
                    <tr>
                        <td style="padding: 35px 25px;">
                            
                            <!-- Invoice Box with golden accent -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0; border: 1px solid #30363d; border-radius: 12px; overflow: hidden;">
                                <!-- Invoice Header -->
                                <tr>
                                    <td style="background: linear-gradient(90deg, #1c1c1c 0%, #262626 50%, #1c1c1c 100%); padding: 18px 20px; border-bottom: 1px solid #30363d;">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td>
                                                    <p style="margin: 0; color: #fbbf24; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;">ORDER ID</p>
                                                    <p style="margin: 6px 0 0 0; color: #e5e7eb; font-size: 13px; font-family: 'SF Mono', Monaco, monospace; word-break: break-all;">#{{orderId}}</p>
                                                </td>
                                                <td style="text-align: right;">
                                                    <p style="margin: 0; color: #9ca3af; font-size: 11px; text-transform: uppercase;">Date</p>
                                                    <p style="margin: 6px 0 0 0; color: #e5e7eb; font-size: 14px; font-weight: 500;">{{paidAt}}</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Pass Details Section -->
                                <tr>
                                    <td style="padding: 20px; background-color: #0d1117;">
                                        <p style="margin: 0 0 16px 0; color: #fbbf24; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;">🎫 Your Passes</p>

                                        <!-- Column headers -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 8px;">
                                            <tr>
                                                <td style="padding: 8px 0; color: #6b7280; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #30363d;">Pass</td>
                                                <td style="padding: 8px 0; color: #6b7280; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; text-align: center; width: 50px; border-bottom: 1px solid #30363d;">Qty</td>
                                                <td style="padding: 8px 0; color: #6b7280; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; text-align: right; width: 100px; border-bottom: 1px solid #30363d;">Amount</td>
                                            </tr>
                                        </table>

                                        <!-- Line items -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            {{#each items}}
                                            <tr>
                                                <td style="padding: 14px 0; color: #f3f4f6; font-size: 15px; font-weight: 500; border-bottom: 1px solid #21262d;">
                                                    <span style="color: #fbbf24;">✦</span> {{this.passName}}
                                                </td>
                                                <td style="padding: 14px 0; color: #d1d5db; font-size: 15px; text-align: center; border-bottom: 1px solid #21262d;">{{this.quantity}}</td>
                                                <td style="padding: 14px 0; color: #f3f4f6; font-size: 15px; font-weight: 500; text-align: right; border-bottom: 1px solid #21262d;">₹{{this.unitPrice}}</td>
                                            </tr>
                                            {{/each}}
                                        </table>

                                        <!-- Subtotal / Discount -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 16px;">
                                            <tr>
                                                <td style="padding: 8px 0; color: #9ca3af; font-size: 14px;">Subtotal</td>
                                                <td style="padding: 8px 0; color: #e5e7eb; font-size: 14px; text-align: right;">₹{{subtotal}}</td>
                                            </tr>
                                            {{#if discount}}
                                            <tr>
                                                <td style="padding: 8px 0; color: #9ca3af; font-size: 14px;">
                                                    Discount{{#if couponCode}} <span style="color: #22c55e;">({{couponCode}})</span>{{/if}}
                                                </td>
                                                <td style="padding: 8px 0; color: #4ade80; font-size: 14px; font-weight: 600; text-align: right;">−₹{{discount}}</td>
                                            </tr>
                                            {{/if}}
                                        </table>

                                        <!-- Total with golden highlight -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 16px; padding-top: 16px; border-top: 2px solid #fbbf24;">
                                            <tr>
                                                <td style="color: #f3f4f6; font-size: 18px; font-weight: 700;">Total Paid</td>
                                                <td style="color: #fbbf24; font-size: 26px; font-weight: 800; text-align: right; text-shadow: 0 0 20px rgba(251, 191, 36, 0.3);">₹{{totalAmount}}</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- Success Badge -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 28px;">
                                <tr>
                                    <td style="padding: 18px 20px; background: linear-gradient(90deg, #052e16 0%, #14532d 50%, #052e16 100%); border-radius: 10px; border: 1px solid #22c55e;">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td style="width: 40px; vertical-align: middle;">
                                                    <div style="width: 36px; height: 36px; background-color: #22c55e; border-radius: 50%; text-align: center; line-height: 36px;">
                                                        <span style="color: white; font-size: 18px;">✓</span>
                                                    </div>
                                                </td>
                                                <td style="vertical-align: middle; padding-left: 12px;">
                                                    <p style="margin: 0; color: #4ade80; font-size: 15px; font-weight: 700;">Payment Successful</p>
                                                    <p style="margin: 4px 0 0 0; color: #86efac; font-size: 13px;">Your passes are ready and waiting for you!</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- CTA Button -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center; padding: 10px 0 24px 0;">
                                        <a href="{{viewPassUrl}}" style="display: inline-block; padding: 18px 50px; background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); color: #0d1117; text-decoration: none; border-radius: 10px; font-weight: 800; font-size: 15px; letter-spacing: 1px; text-transform: uppercase; box-shadow: 0 4px 20px rgba(251, 191, 36, 0.4);">
                                            View My Passes →
                                        </a>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- Festival excitement message -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="text-align: center;">
                                <tr>
                                    <td>
                                        <p style="margin: 0 0 8px 0; font-size: 28px;">🎭🎪🎶</p>
                                        <p style="margin: 0; color: #9ca3af; font-size: 15px; line-height: 1.7;">
                                            Get ready for an unforgettable experience at<br>
                                            <span style="color: #fbbf24; font-weight: 600;">IIT BHU's Premier Cultural Festival!</span>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    
                    <!-- Footer -->
                    <tr>
                        <td style="padding: 28px 20px; background: linear-gradient(180deg, #0d1117 0%, #161b22 100%); text-align: center; border-top: 1px solid #30363d;">
                            <p style="margin: 0 0 6px 0; color: #fbbf24; font-size: 18px; font-weight: 700; letter-spacing: 3px;">KASHIYATRA 2027</p>
                            <p style="margin: 0 0 16px 0; color: #6b7280; font-size: 13px;">Where Culture Meets Celebration</p>
                            <p style="margin: 0; color: #4b5563; font-size: 11px; line-height: 1.6;">
                                IIT (BHU) Varanasi • For queries: kashiyatra@itbhu.ac.in
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
