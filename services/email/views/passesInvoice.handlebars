<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="color-scheme" content="light only">
    <meta name="supported-color-schemes" content="light only">
    <title>🎉 Payment Successful - Kashiyatra 2027</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f3f4f6;">
        <tr>
            <td style="padding: 20px 10px;">
                <!-- Main Container -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; overflow: hidden; border: 1px solid #e5e7eb;">
                    
                    <!-- Celebratory Header -->
                    <tr>
                        <td style="background-color: #065f46; background: linear-gradient(135deg, #047857 0%, #059669 50%, #10b981 100%); padding: 45px 20px; text-align: center;">
                            <!-- Sparkle decoration -->
                            <p style="margin: 0 0 8px 0; font-size: 32px;">✨🎊✨</p>
                            <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: 800; letter-spacing: 3px;">KASHIYATRA 2027</h1>
                            <p style="margin: 12px 0 0 0; color: #ffffff; font-size: 15px; font-weight: 700; letter-spacing: 2px;">PAYMENT SUCCESSFUL</p>
                        </td>
                    </tr>
                    
                    <!-- Success Confirmation Banner -->
                    <tr>
                        <td style="background-color: #ffffff; padding: 32px 20px; text-align: center; border-bottom: 3px solid #16a34a;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center;">
                                        <!-- Success checkmark circle -->
                                        <div style="display: inline-block; width: 70px; height: 70px; background-color: #16a34a; border-radius: 50%; line-height: 70px; margin-bottom: 16px;">
                                            <span style="color: #ffffff; font-size: 40px; font-weight: 700;">✓</span>
                                        </div>
                                        <h2 style="margin: 0; color: #065f46; font-size: 26px; font-weight: 800;">
                                            Thank you, {{userName}}! 🎉
                                        </h2>
                                        <p style="margin: 10px 0 0 0; color: #374151; font-size: 15px;">
                                            Your passes are confirmed. See you at the festival!
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    
                    <!-- Content -->
                    <tr>
                        <td style="padding: 35px 25px;">
                            
                            <!-- Invoice Box with golden accent -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden;">
                                <!-- Invoice Header -->
                                <tr>
                                    <td style="background-color: #fdf6e3; padding: 18px 20px; border-bottom: 1px solid #e5e7eb;">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td>
                                                    <p style="margin: 0; color: #b45309; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;">ORDER ID</p>
                                                    <p style="margin: 6px 0 0 0; color: #1f2937; font-size: 13px; font-family: 'SF Mono', Monaco, monospace; word-break: break-all;">#{{orderId}}</p>
                                                </td>
                                                <td style="text-align: right;">
                                                    <p style="margin: 0; color: #6b7280; font-size: 11px; text-transform: uppercase;">Date</p>
                                                    <p style="margin: 6px 0 0 0; color: #1f2937; font-size: 14px; font-weight: 500;">{{paidAt}}</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Pass Details Section -->
                                <tr>
                                    <td style="padding: 20px; background-color: #ffffff;">
                                        <p style="margin: 0 0 16px 0; color: #b45309; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;">🎫 Your Passes</p>

                                        <!-- Column headers -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 8px;">
                                            <tr>
                                                <td style="padding: 8px 0; color: #9ca3af; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #e5e7eb;">Pass</td>
                                                <td style="padding: 8px 0; color: #9ca3af; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; text-align: center; width: 50px; border-bottom: 1px solid #e5e7eb;">Qty</td>
                                                <td style="padding: 8px 0; color: #9ca3af; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; text-align: right; width: 100px; border-bottom: 1px solid #e5e7eb;">Amount</td>
                                            </tr>
                                        </table>

                                        <!-- Line items -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            {{#each items}}
                                            <tr>
                                                <td style="padding: 14px 0; color: #1f2937; font-size: 15px; font-weight: 500; border-bottom: 1px solid #f3f4f6;">
                                                    <span style="color: #d4a017;">✦</span> {{this.passName}}
                                                </td>
                                                <td style="padding: 14px 0; color: #4b5563; font-size: 15px; text-align: center; border-bottom: 1px solid #f3f4f6;">{{this.quantity}}</td>
                                                <td style="padding: 14px 0; color: #1f2937; font-size: 15px; font-weight: 500; text-align: right; border-bottom: 1px solid #f3f4f6;">₹{{this.unitPrice}}</td>
                                            </tr>
                                            {{/each}}
                                        </table>

                                        <!-- Subtotal / Discount -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 16px;">
                                            <tr>
                                                <td style="padding: 8px 0; color: #6b7280; font-size: 14px;">Subtotal</td>
                                                <td style="padding: 8px 0; color: #1f2937; font-size: 14px; text-align: right;">₹{{subtotal}}</td>
                                            </tr>
                                            {{#if discount}}
                                            <tr>
                                                <td style="padding: 8px 0; color: #6b7280; font-size: 14px;">
                                                    Discount{{#if couponCode}} <span style="color: #16a34a;">({{couponCode}})</span>{{/if}}
                                                </td>
                                                <td style="padding: 8px 0; color: #16a34a; font-size: 14px; font-weight: 600; text-align: right;">−₹{{discount}}</td>
                                            </tr>
                                            {{/if}}
                                        </table>

                                        <!-- Total with golden highlight -->
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 16px; padding-top: 16px; border-top: 2px solid #d4a017;">
                                            <tr>
                                                <td style="color: #1f2937; font-size: 18px; font-weight: 700;">Total Paid</td>
                                                <td style="color: #b45309; font-size: 26px; font-weight: 800; text-align: right;">₹{{totalAmount}}</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- Success Badge -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 28px;">
                                <tr>
                                    <td style="padding: 18px 20px; background-color: #ecfdf5; border-radius: 10px; border: 1px solid #16a34a;">
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td style="width: 40px; vertical-align: middle;">
                                                    <div style="width: 36px; height: 36px; background-color: #16a34a; border-radius: 50%; text-align: center; line-height: 36px;">
                                                        <span style="color: #ffffff; font-size: 18px;">✓</span>
                                                    </div>
                                                </td>
                                                <td style="vertical-align: middle; padding-left: 12px;">
                                                    <p style="margin: 0; color: #065f46; font-size: 15px; font-weight: 700;">Payment Successful</p>
                                                    <p style="margin: 4px 0 0 0; color: #15803d; font-size: 13px;">Your passes are ready and waiting for you!</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- CTA Button -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="text-align: center; padding: 10px 0 24px 0;">
                                        <a href="{{viewPassUrl}}" style="display: inline-block; padding: 18px 50px; background-color: #d4a017; background: linear-gradient(135deg, #d4a017 0%, #b45309 100%); color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 800; font-size: 15px; letter-spacing: 1px; text-transform: uppercase;">
                                            View My Passes →
                                        </a>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- Festival excitement message -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="text-align: center;">
                                <tr>
                                    <td>
                                        <p style="margin: 0 0 8px 0; font-size: 28px;">🎭🎪🎶</p>
                                        <p style="margin: 0; color: #6b7280; font-size: 15px; line-height: 1.7;">
                                            Get ready for an unforgettable experience at<br>
                                            <span style="color: #b45309; font-weight: 700;">IIT BHU's Premier Cultural Festival!</span>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    
                    <!-- Footer -->
                    <tr>
                        <td style="padding: 28px 20px; background-color: #fdf6e3; text-align: center; border-top: 1px solid #e5e7eb;">
                            <p style="margin: 0 0 6px 0; color: #b45309; font-size: 18px; font-weight: 800; letter-spacing: 3px;">KASHIYATRA 2027</p>
                            <p style="margin: 0 0 16px 0; color: #78350f; font-size: 13px;">Where Culture Meets Celebration</p>
                            <p style="margin: 0; color: #9ca3af; font-size: 11px; line-height: 1.6;">
                                IIT (BHU) Varanasi • For queries: kashiyatra@itbhu.ac.in
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
