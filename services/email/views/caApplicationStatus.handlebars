<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>CA Application {{#if isApproved}}Approved{{else}}Update{{/if}} - Kashiyatra 2027</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f5f5f5;">
        <tr>
            <td style="padding: 40px 20px;">
                <!-- Main Container -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 560px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.08);">
                    <!-- Header -->
                    <tr>
                        {{#if isApproved}}
                        <td style="background: linear-gradient(135deg, #8B1538 0%, #6B1028 50%, #4B0A18 100%); padding: 48px 40px; text-align: center;">
                        {{else}}
                        <td style="background: linear-gradient(135deg, #6b7280 0%, #4b5563 50%, #374151 100%); padding: 48px 40px; text-align: center;">
                        {{/if}}
                            <h1 style="margin: 0; color: #ffffff; font-size: 26px; font-weight: 700; letter-spacing: 3px; text-shadow: 0 2px 4px rgba(0,0,0,0.2);">KASHIYATRA 2027</h1>
                            <p style="margin: 12px 0 0 0; color: rgba(255,255,255,0.9); font-size: 13px; font-weight: 500; letter-spacing: 1px;">
                                CAMPUS AMBASSADOR PROGRAM
                            </p>
                        </td>
                    </tr>
                    
                    <!-- Content -->
                    <tr>
                        <td style="padding: 40px;">
                            <!-- Icon -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
                                <tr>
                                    <td style="text-align: center;">
                                        {{#if isApproved}}
                                        <div style="display: inline-block; width: 72px; height: 72px; background: linear-gradient(135deg, #8B1538 0%, #6B1028 100%); border-radius: 50%; line-height: 72px; box-shadow: 0 8px 20px rgba(139,21,56,0.35);">
                                            <span style="font-size: 32px;">🎉</span>
                                        </div>
                                        {{else}}
                                        <div style="display: inline-block; width: 72px; height: 72px; background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%); border-radius: 50%; line-height: 72px; box-shadow: 0 8px 20px rgba(107,114,128,0.35);">
                                            <span style="font-size: 32px;">📋</span>
                                        </div>
                                        {{/if}}
                                    </td>
                                </tr>
                            </table>

                            <!-- Title & Greeting -->
                            {{#if isApproved}}
                            <h2 style="margin: 0 0 8px 0; color: #8B1538; font-size: 24px; font-weight: 600; text-align: center;">Congratulations! 🎊</h2>
                            <p style="margin: 0 0 28px 0; color: #666666; font-size: 15px; line-height: 1.6; text-align: center;">
                                Hi <strong>{{userName}}</strong>, your Campus Ambassador application has been <span style="color: #059669; font-weight: 600;">approved</span>!
                            </p>
                            {{else}}
                            <h2 style="margin: 0 0 8px 0; color: #4b5563; font-size: 24px; font-weight: 600; text-align: center;">Application Update</h2>
                            <p style="margin: 0 0 28px 0; color: #666666; font-size: 15px; line-height: 1.6; text-align: center;">
                                Hi <strong>{{userName}}</strong>, we have reviewed your Campus Ambassador application.
                            </p>
                            {{/if}}
                            
                            {{#if isApproved}}
                            <!-- Referral ID Card (for approved) -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    <td style="padding: 28px; background: linear-gradient(135deg, #fdf2f4 0%, #fce7eb 100%); border-radius: 16px; border: 2px solid #f9d0d9; text-align: center;">
                                        <p style="margin: 0 0 8px 0; color: #8B1538; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Your Unique Referral ID</p>
                                        <p style="margin: 0; color: #8B1538; font-size: 32px; font-weight: 700; letter-spacing: 4px; font-family: 'Monaco', 'Consolas', monospace;">{{referralId}}</p>
                                        <p style="margin: 12px 0 0 0; color: #9f3d5c; font-size: 12px;">Share this code with friends to earn rewards!</p>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- What's Next Card -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    <td style="padding: 24px; background-color: #f8f8f8; border-radius: 12px; border: 1px solid #e5e5e5;">
                                        <p style="margin: 0 0 16px 0; color: #1a1a1a; font-size: 15px; font-weight: 600;">🚀 What's Next?</p>
                                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                            <tr>
                                                <td style="padding: 8px 0; vertical-align: top; width: 28px;">
                                                    <span style="display: inline-block; width: 24px; height: 24px; background: #8B1538; color: #fff; border-radius: 50%; text-align: center; line-height: 24px; font-size: 12px; font-weight: 600;">1</span>
                                                </td>
                                                <td style="padding: 8px 0 8px 12px; color: #666666; font-size: 14px; line-height: 1.5;">
                                                    <strong style="color: #1a1a1a;">Share Your Referral Code</strong><br>
                                                    Spread the word about Kashiyatra 2027 using your unique code
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; vertical-align: top; width: 28px;">
                                                    <span style="display: inline-block; width: 24px; height: 24px; background: #8B1538; color: #fff; border-radius: 50%; text-align: center; line-height: 24px; font-size: 12px; font-weight: 600;">2</span>
                                                </td>
                                                <td style="padding: 8px 0 8px 12px; color: #666666; font-size: 14px; line-height: 1.5;">
                                                    <strong style="color: #1a1a1a;">Track Your Referrals</strong><br>
                                                    Monitor your referral count in your CA dashboard
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; vertical-align: top; width: 28px;">
                                                    <span style="display: inline-block; width: 24px; height: 24px; background: #8B1538; color: #fff; border-radius: 50%; text-align: center; line-height: 24px; font-size: 12px; font-weight: 600;">3</span>
                                                </td>
                                                <td style="padding: 8px 0 8px 12px; color: #666666; font-size: 14px; line-height: 1.5;">
                                                    <strong style="color: #1a1a1a;">Earn Rewards</strong><br>
                                                    Get exclusive perks, passes, and recognition for top performers
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- CTA Button -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    <td style="text-align: center;">
                                        <a href="{{dashboardUrl}}" style="display: inline-block; padding: 14px 32px; background: linear-gradient(135deg, #8B1538 0%, #6B1028 100%); color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; border-radius: 8px; box-shadow: 0 4px 12px rgba(139,21,56,0.35);">
                                            Go to CA Dashboard →
                                        </a>
                                    </td>
                                </tr>
                            </table>
                            
                            {{else}}
                            <!-- Rejection Notice -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    <td style="padding: 24px; background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%); border-radius: 12px; border: 1px solid #e5e7eb;">
                                        <p style="margin: 0 0 4px 0; color: #888888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Application Status</p>
                                        <p style="margin: 0 0 16px 0; color: #dc2626; font-size: 16px; font-weight: 600;">Not Approved</p>
                                        
                                        <p style="margin: 0 0 4px 0; color: #888888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Reason</p>
                                        <p style="margin: 0; color: #374151; font-size: 14px; line-height: 1.6;">{{rejectionReason}}</p>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- Encouragement -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    <td style="padding: 20px 24px; background-color: #fffbeb; border-radius: 8px; border-left: 3px solid #f59e0b;">
                                        <p style="margin: 0 0 8px 0; color: #92400e; font-size: 14px; font-weight: 600;">💡 Don't be discouraged!</p>
                                        <p style="margin: 0; color: #a16207; font-size: 13px; line-height: 1.6;">
                                            You can still be a part of Kashiyatra 2027! Register for events, attend Pro Nites, and enjoy the cultural extravaganza. We'd love to see you there!
                                        </p>
                                    </td>
                                </tr>
                            </table>
                            
                            <!-- CTA Button -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 28px 0;">
                                <tr>
                                    <td style="text-align: center;">
                                        <a href="{{websiteUrl}}" style="display: inline-block; padding: 14px 32px; background: linear-gradient(135deg, #6b7280 0%, #4b5563 100%); color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; border-radius: 8px; box-shadow: 0 4px 12px rgba(107,114,128,0.35);">
                                            Explore Kashiyatra 2027 →
                                        </a>
                                    </td>
                                </tr>
                            </table>
                            {{/if}}
                            
                            <!-- Divider -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: 0 0 24px 0;">
                                <tr>
                                    <td style="border-top: 1px solid #eeeeee;"></td>
                                </tr>
                            </table>
                            
                            <!-- Contact Info -->
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="padding: 16px 20px; background-color: #f8f8f8; border-radius: 8px;">
                                        <p style="margin: 0 0 8px 0; color: #666666; font-size: 13px; font-weight: 600;">📧 Have questions?</p>
                                        <p style="margin: 0; color: #888888; font-size: 13px; line-height: 1.5;">
                                            Reach out to us at <a href="mailto:ca@kashiyatra.org" style="color: #8B1538; text-decoration: none; font-weight: 500;">ca@kashiyatra.org</a>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    
                    <!-- Footer -->
                    <tr>
                        <td style="padding: 24px 40px; background-color: #fafafa; text-align: center; border-top: 1px solid #eeeeee;">
                            <p style="margin: 0 0 4px 0; color: #8B1538; font-size: 12px; font-weight: 600;">Kashiyatra 2027</p>
                            <p style="margin: 0 0 12px 0; color: #999999; font-size: 11px;">IIT (BHU) Varanasi</p>
                            <p style="margin: 0; color: #cccccc; font-size: 10px;">
                                <a href="https://kashiyatra.org" style="color: #888888; text-decoration: none;">Website</a> · 
                                <a href="https://instagram.com/kashiyatra" style="color: #888888; text-decoration: none;">Instagram</a> · 
                                <a href="https://facebook.com/kashiyatra" style="color: #888888; text-decoration: none;">Facebook</a>
                            </p>
                        </td>
                    </tr>
                </table>
                
                <!-- Sub-footer -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="max-width: 560px; margin: 20px auto 0;">
                    <tr>
                        <td style="text-align: center;">
                            <p style="margin: 0; color: #999999; font-size: 11px; line-height: 1.5;">
                                This is an automated notification regarding your CA application.<br>
                                Please do not reply to this email.
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
