{
  "name": "ky-2027-backend",
  "version": "1.0.0",
  "description": "Kashi Yatra 2027 Backend - Standalone Express Server",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm dlx tsc-alias -p tsconfig.build.json",
    "dev": "pnpm run build && cross-env NODE_ENV=development nodemon ./JS/server/server.js",
    "start:prod": "pnpm run build && cross-env NODE_ENV=production node ./JS/clusterManager/clusterManager.js",
    "start:test": "pnpm run build && cross-env NODE_ENV=testing node ./JS/server/server.js",
    "worker": "cross-env NODE_ENV=development node ./JS/redis/Workers/writeWorkers.js",
    "lint": "eslint .",
    "watch": "tsc --watch",
    "check-types": "tsc --noEmit",
    "seed-prisma": "npx tsx data/seeder.ts",
    "seed-mongo": "npx tsx data/mongo.seeder.ts",
    "seed:passes": "pnpm run build && node ./JS/scripts/seedPasses.script.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "express",
    "graphql",
    "prisma",
    "mongodb",
    "redis"
  ],
  "author": "",
  "license": "ISC",
  "exports": {
    "./gqlFactory": "./JS/graphql-execution-engine/QueryBuilder/factory/factory.class.js"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/client-sesv2": "^3.1061.0",
    "@aws-sdk/client-sns": "^3.1061.0",
    "@aws-sdk/client-textract": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.7.15",
    "@prisma/adapter-pg": "^6.9.0",
    "@prisma/client": "^7.10.0",
    "@t3-oss/env-core": "^0.13.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "cryptr": "^6.4.0",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "gql-axon": "2.1.3",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.5",
    "mongoose": "^9.6.3",
    "morgan": "^1.11.0",
    "multer": "^2.4.0",
    "next-auth": "^4.24.14",
    "nodemailer": "^9.0.1",
    "nodemailer-express-handlebars": "^7.0.0",
    "redis-axon": "^1.4.1",
    "redlock": "4.2.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0",
    "zodex-axon": "^1.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.1141.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-handlebars": "^6.0.2",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "@types/redlock": "^4.0.8",
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3"
  }
}
