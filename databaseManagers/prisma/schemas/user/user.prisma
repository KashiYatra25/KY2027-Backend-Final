enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  id        String     @id
  email     String     @unique
  firstName String?    // NULL until profile completed
  lastName  String?
  slugName  String     // Username extracted from email - always set
  candidatePhotoUrl String?
  googleAvatarUrl String?
  phone     String?    // NULL until phone verified
  gender    Gender?
  college   String?
  dob       DateTime?  // Date of birth
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Aadhaar verification
  aadhaarNumber String? // Full Aadhaar number (stored securely, never sent to frontend)
  aadhaarS3Key  String? // S3 key for uploaded Aadhaar image (temporary)
  isFromIITBhu  Boolean @default(false)
  isPaidUser    Boolean @default(false) // True for IIT BHU users (auto) or after payment

  // Referral tracking - set when user applies a CA's referral code
  referredByCaId String?   // CaProfile.id of the CA who referred this user
  referredAt     DateTime? // When the referral was applied

  // Universal relations
  role          Role?
  admin         Admin?
  caApplication CaApplication?
  caProfile     CaProfile?
  couponUsages  CouponUsage[]
  referredByCa  CaProfile?    @relation("ReferredUsers", fields: [referredByCaId], references: [id])
}
