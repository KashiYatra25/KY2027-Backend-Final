// CA Profile - Created when CA application is approved
// Stores referral tracking data for Campus Ambassadors

model CaProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  referralId       String   @unique // Unique referral code for this CA
  numberOfReferrals Int     @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  caApplication   CaApplication @relation(fields: [caApplicationId], references: [id])
  caApplicationId String        @unique
  referredUsers   User[]        @relation("ReferredUsers") // Users who used this CA's referral code
}
