// ═══════════════════════════════════════════════════════════════════
// COUPON SCHEMA
// Discount coupons for pass purchases
// ═══════════════════════════════════════════════════════════════════

enum CouponType {
  PERCENTAGE  // e.g., 10% off
  FIXED       // e.g., ₹200 off
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

// Lifecycle of a single coupon claim.
// RESERVED -> claimed at checkout (counter already incremented, holds a slot)
// USED     -> payment succeeded, reservation finalised
// (a released reservation is deleted, so there is no RELEASED state)
enum CouponUsageStatus {
  RESERVED
  USED
}

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique  // e.g., "EARLY20", "CA100"
  description     String?               // Optional description for admin
  
  // Discount configuration
  type            CouponType            // PERCENTAGE or FIXED
  value           Int                   // 20 for 20% or 200 for ₹200
  
  // Usage limits
  maxUsageCount   Int?                  // Total times coupon can be used (null = unlimited)
  maxUsagePerUser Int       @default(1) // Times a single user can use it
  currentUsageCount Int     @default(0) // Track total usage
  
  // Validity period
  validFrom       DateTime   @default(now())
  validUntil      DateTime?             // null = no expiry
  
  // Status
  status          CouponStatus @default(ACTIVE)
  
  // Metadata
  createdBy       String?               // Admin who created it
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  // Relations
  usages          CouponUsage[]
}

model CouponUsage {
  id            String   @id @default(cuid())
  
  // References
  couponId      String
  userId        String
  
  // Usage details
  discountAmount Int               // Actual discount applied

  // Reservation lifecycle.
  // A row is created with RESERVED at checkout time (atomically holding a
  // slot against maxUsageCount / maxUsagePerUser). It becomes USED when the
  // payment webhook reports PAID, or is deleted (slot released + counter
  // decremented) when the payment fails/expires or the pending order is
  // cleaned up.
  status        CouponUsageStatus @default(RESERVED)

  // When a RESERVED row should be considered stale and eligible for cleanup.
  // Set to the pending-order expiry window at reservation time.
  reservedUntil DateTime?
  
  // Payment reference (to be linked with payment/order later)
  orderId       String?  @unique   // Will be set when payment system is integrated
  
  // Timestamps
  usedAt        DateTime @default(now())
  
  // Relations
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  // Indexes
  @@index([couponId])
  @@index([userId])
  @@index([status, reservedUntil]) // For cleanup of stale reservations
  @@index([couponId, userId, status]) // Fast per-user active-usage counting
  @@unique([couponId, userId, orderId]) // Prevent duplicate usage per order
}
