// ═══════════════════════════════════════════════════════════════════
// ACCOUNT STATUS CHANGE AUDIT LOG
// Tracks both suspensions and reactivations
// The `reason` field is prefixed with [SUSPEND] or [REACTIVATE] to identify the action
// ═══════════════════════════════════════════════════════════════════

model AccountSuspension {
  id          String   @id @default(uuid())
  userId      String   // User whose status was changed
  suspendedBy String   // Admin ID who performed the action
  reason      String   // Prefixed with [SUSPEND] or [REACTIVATE] + reason (min 10 chars enforced at app level)
  suspendedOn DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user  User  @relation(fields: [userId], references: [id])
  admin Admin @relation(fields: [suspendedBy], references: [id])

  @@index([userId])
  @@index([suspendedBy])
}
